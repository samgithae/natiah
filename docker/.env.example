# Natiah - Environment Configuration
# Copy this file to .env and fill in your values

# --- Database ---
DATABASE_URL=postgresql+asyncpg://natiah:natiah@postgres:5432/natiah

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Security ---
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=604800

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Database (dev only) ---
DB_AUTO_CREATE=true

# --- LinkedIn OAuth (REQUIRED for account connection) ---
# Create a LinkedIn Developer App at https://www.linkedin.com/developers/apps
# 1. Create a new app (verify email domain if needed)
# 2. Add "Sign In with LinkedIn" product
# 3. Under Auth tab, copy Client ID and Client Secret
# 4. Add OAuth redirect URL: http://localhost:8000/api/v1/accounts/{account_id}/oauth/callback
#    (For production, replace localhost:8000 with your backend domain)
# 5. Request these permissions: openid, profile, email, w_member_social
#    (w_member_social requires Marketing Developer Platform approval - see below)
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
LINKEDIN_CALLBACK_URL=http://localhost:8000/api/v1/accounts/{account_id}/oauth/callback
LINKEDIN_SCOPES=openid profile email w_member_social

# --- Admin Seed (optional, for auto-seeding admin user on startup) ---
NATIAH_ADMIN_EMAIL=admin@natiah.com
NATIAH_ADMIN_PASSWORD=admin123

# --- Playwright ---
PLAYWRIGHT_HEADLESS=true

# --- Admin user seed on startup ---
# NATIAH_ADMIN_FORCE=1
