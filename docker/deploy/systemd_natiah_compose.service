[Unit]
Description=Natiah (Docker Compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/natiah
EnvironmentFile=/opt/natiah/docker/.env.prod
ExecStart=/usr/bin/docker compose --env-file /opt/natiah/docker/.env.prod -f docker/docker-compose.yml -f docker/docker-compose.prod.yml up -d
ExecStop=/usr/bin/docker compose --env-file /opt/natiah/docker/.env.prod -f docker/docker-compose.yml -f docker/docker-compose.prod.yml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
